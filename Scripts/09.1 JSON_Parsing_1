-- Data Parsing

-- JSON Data -- Semi-Structred Data -- No Rows and Columns

-- We get JSON Data from below Sources

     -- CRMs
     -- Streamin Data
     -- Applications

-- Universal data Format -- Cause most of Applications / Users / Enginners can easily work w this data.

{
    'Key': value,
    'Skills': ['data', 'AI', 'Swimming']     - Arruy,
    (
        {


        }

    )

}

create or replace transient table json_tbl(
    json_col variant
);

desc table json_tbl;

-- Fails

insert into json_tbl(json_col) 
    values ('{"firstName":"John", "empid":1001}');

-- Also fails

insert into json_tbl(json_col) 
    select '{"firstName":"John", "empid":1001}';


-- Use  PARSE_JSON()

insert into json_tbl(json_col) 
    select parse_json('{"firstName":"John", "empid":1001}');


-- Order of Insertion is Not followed in JSON
select * from json_tbl;

delete from json_tbl;

insert into json_tbl (json_col)
    select parse_json(Column1) from values 
        ('{"firstName":"Name-1", "empid":1001}'),
        ('{"firstName":"Name-2", "empid":1002}'),
        ('{"firstName":"Name-3", "empid":1003}'),
        ('{"firstName":"Name-4", "empid":1004}'),
        ('{"firstName":"Name-5", "empid":1005}')
        ;

-- order of field still changed..

-- so it is not easy to insert the json data via insert statement.
delete from json_tbl;

-- If Any Issues in JSON Data while Loading into VARIANT Col INSERTION FAILS

