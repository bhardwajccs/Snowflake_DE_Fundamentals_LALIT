/*
EXTERNAL TABLES

Snowflake external tables allow you to query data stored in cloud storage (Amazon S3, Google Cloud Storage, or Microsoft Azure) without loading it into Snowflake. They function as a "read-only" metadata layer over files in an external stage, making them ideal for data lake architectures or cost-effective archival.

Benefits of External Tables
  1 They allow to analyze data without moving data from Stage into Tables so saves time + storage space.
  2 They support Query and Joins we can combine them w regular tables, allows Views as well.

Disadvantages
  1 Query time will be slow as we are querying data from external stages.
  2 Only READ Only No DML.
  3 External Stage must be there that may add complexity.  
*/
 Show stages;

LIST @Azure_Ext_Stg_New

LIST  @Azure_Ext_Stg;

-- method 1

-- External Table without SCHEMA

-- Ext table has VALUS Column by DEFAULT to hold all data.

CREATE OR REPLACE EXTERNAL TABLE my_ext_tbl
    with location = @Azure_Ext_Stg_New
    AUTO_REFRESH = TRUE    -- It means if New File is added in Source SF will try to AUTO Refrsh Ext. Table
    file_format = ( TYPE = CSV 
                    SKIP_HEADER = 1 
                    FIELD_OPTIONALLY_ENCLOSED_BY = '"'
                );

Select * from my_ext_tbl;

Select $1,$2 from @Azure_Ext_Stg;

Select VALUE:c1::varchar as "Course.value", VALUE from my_ext_tbl;


Select VALUE:c1:: varchar as DepttNames from my_ext_tbl;

-- Data of c2 column
-- CTAS  
CREATE TABLE Dummy222 
AS
Select 
    VALUE:c2::varchar as "Country.value", 
    VALUE:c1::varchar as "Segment.value" 
from my_ext_tbl;

Select * from Dummy;


-- INSERT INTO SELECT
INSERT INTO Dummy2
    Select VALUE:c2::varchar as "Country.value", VALUE:c1::varchar as "Segment.value" from my_ext_tbl;





-- Method 2 

-- Make table with columns from External files

CREATE OR REPLACE EXTERNAL TABLE tbl_w_cols
    (
        C1 varchar AS (VALUE:c1::varchar),
        C2 varchar AS (VALUE:c2::varchar)
    )
    location = @Azure_Ext_Stg
    AUTO_REFRESH = FALSE
    file_format = CSV_FORMAT_NEW;

Select C1,C2 from tbl_w_cols;

-- See Filenames as well
Select C1,C2, METADATA$FILENAME from tbl_w_cols;




